rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Public catalog assets (products, categories, banners)
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /categories/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /banners/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Customer private assets (avatars, order/return attachments)
    match /users/{userId}/{allPaths=**} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && request.resource.size < 5 * 1024 * 1024;
    }

    match /returns/{userId}/{allPaths=**} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && request.resource.size < 10 * 1024 * 1024;
    }
  }
}
