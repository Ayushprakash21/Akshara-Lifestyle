rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasAnyRole(roles) {
      return isAuthenticated() && (
        (request.auth.token.role != null && request.auth.token.role in roles) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().role in roles)
      );
    }

    function isSuperAdmin() {
      return hasAnyRole(['super_admin']);
    }

    function isAdmin() {
      return hasAnyRole(['super_admin', 'admin']);
    }

    function isProductManager() {
      return hasAnyRole(['super_admin', 'admin', 'product_manager', 'merchandiser']);
    }

    function isOrderManager() {
      return hasAnyRole(['super_admin', 'admin', 'order_manager', 'operations']);
    }

    // 1. Users collection
    // Customers can read/update their own document but cannot elevate their own role
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && request.auth.uid == userId && (
        request.resource.data.role == 'customer' || isAdmin()
      );
      allow update: if isOwner(userId) && (
        // Prevent self-role-escalation
        request.resource.data.role == resource.data.role || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // 2. Products collection
    // Public read for storefront, restricted write to product managers and admins
    match /products/{productId} {
      allow read: if true;
      allow write: if isProductManager();
    }

    // 3. Categories collection
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isProductManager();
    }

    // 4. Inventory collection
    match /inventory/{productId} {
      allow read: if true;
      allow write: if isProductManager() || isOrderManager();
    }

    // 5. Orders collection
    // Customers can view only their own orders. Order managers/admins have full access.
    match /orders/{orderId} {
      allow read: if isOwner(resource.data.userId) || isOrderManager();
      allow create: if (isAuthenticated() && request.resource.data.userId == request.auth.uid) ||
                       request.resource.data.userId == 'guest' ||
                       isOrderManager();
      allow update: if isOrderManager();
      allow delete: if isAdmin();
    }

    // 6. Carts collection
    // Only the authenticated customer owns their cart
    match /carts/{userId} {
      allow read, write: if isOwner(userId);
    }

    // 7. Wishlists collection
    // Only the authenticated customer owns their wishlist
    match /wishlists/{userId} {
      allow read, write: if isOwner(userId);
    }

    // 8. Addresses subcollection or collection
    match /addresses/{addressId} {
      allow read, write: if isOwner(resource.data.userId) || isAdmin();
    }

    // 9. Coupons collection
    // Public read for validation, admin write only
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 10. Reviews collection
    // Approved reviews are publicly readable, authenticated users can write reviews
    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // 11. Banners and Homepage CMS
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
